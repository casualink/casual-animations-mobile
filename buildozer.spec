[app]
title = Casual Animations Mobile
package.name = casualanimationsmobile
package.domain = org.casualink.casualanimationsmobile
source.dir = .
source.include_exts = py,png,jpg,kv,atlas,ttf,mp4,mp3,wav
version = 1.0
requirements = python3,kivy
orientation = portrait
fullscreen = 0
android.api = 33
android.minapi = 21
android.ndk = 25b
android.sdk = 33
android.archs = arm64-v8a,armeabi-v7a

[buildozer]
log_level = 2
warn_on_root = 1
